{
    "version": "0.1.29",
    "description": "A dependency manager that builds native libraries from source",
    "homepage": "https://git.e-poison.com/sasha/otok",
    "license": "GPL-3.0-only",
    "notes": "otok builds with the tools of the machine: Visual Studio's C++ tools for the native target, git, and MSYS2 for the recipes of autotools ('tool-paths' in otok's config.toml).",
    "suggest": {
        "git": "git",
        "MSYS2": "msys2"
    },
    "architecture": {
        "64bit": {
            "url": "https://git.e-poison.com/sasha/otok/releases/download/v0.1.29/otok-0.1.29-windows-x64.zip",
            "hash": "5a6849066233a5b583ae9db041a5e1c63f666b3d3522451d52cd005549b12a95"
        }
    },
    "bin": "otok.exe",
    "checkver": {
        "url": "https://git.e-poison.com/api/v1/repos/sasha/otok/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://git.e-poison.com/sasha/otok/releases/download/v$version/otok-$version-windows-x64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
