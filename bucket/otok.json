{
    "version": "0.5.7",
    "description": "A dependency manager that builds native libraries from source",
    "homepage": "https://github.com/otok-dev/otok",
    "license": "GPL-3.0-only WITH AdditionRef-otok-output-exception",
    "notes": "otok builds with Visual Studio's C++ tools and git of the machine; the other tools recipes need (CMake, Ninja, Python, MSYS2's make, ...) are built or fetched by their own recipes.",
    "suggest": {
        "git": "git"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/otok-dev/otok/releases/download/v0.5.7/otok-0.5.7-windows-x64.zip",
            "hash": "e83cacbe462fd0610f6819a0cf2079f3070f6676a6079ddbfc369f4416d2ad7a"
        }
    },
    "bin": "otok.exe",
    "checkver": {
        "github": "https://github.com/otok-dev/otok"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/otok-dev/otok/releases/download/v$version/otok-$version-windows-x64.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
